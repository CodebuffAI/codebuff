{
  "name": "@codebuff/freebuff-desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Freebuff Desktop — GitHub-native coding-agent orchestrator (see docs/freebuff-desktop-prd.md)",
  "author": "Freebuff, Inc.",
  "main": "electron/main.cjs",
  "exports": {
    "./*": {
      "bun": "./src/*.ts",
      "import": "./src/*.ts",
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p src/app/ui/tsconfig.json",
    "test": "bun test",
    "app": "bun run ui:build && electron .",
    "app:server": "PORT=8787 bun src/app/server.ts",
    "ui:dev": "vite",
    "ui:build": "vite build",
    "dev": "bun scripts/dev.ts",
    "stage:bun": "bun scripts/fetch-bun.ts",
    "stage:orchestrator": "bun scripts/build-orchestrator.ts",
    "prepackage": "bun run ui:build && bun scripts/fetch-bun.ts && bun scripts/build-orchestrator.ts",
    "dist": "bun run prepackage && electron-builder",
    "dist:dir": "bun run prepackage && electron-builder --dir"
  },
  "dependencies": {
    "@codebuff/sdk": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "playwright": "1.56.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.2.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/bun": "1.3.11",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.0",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.5"
  },
  "build": {
    "appId": "com.freebuff.desktop",
    "productName": "Freebuff Desktop",
    "electronVersion": "33.4.11",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "npmRebuild": false,
    "files": [
      "electron/**/*",
      "package.json",
      "!**/node_modules/**"
    ],
    "extraResources": [
      {
        "from": "staging/bun",
        "to": "bun"
      },
      {
        "from": "staging/orchestrator",
        "to": "orchestrator"
      }
    ],
    "mac": {
      "target": [
        "dir",
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    }
  }
}
