{
  "name": "@codebuff/internal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "import": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./openrouter-ai-sdk": {
      "bun": "./src/openrouter-ai-sdk/index.ts",
      "import": "./src/openrouter-ai-sdk/index.ts",
      "types": "./src/openrouter-ai-sdk/index.ts",
      "default": "./src/openrouter-ai-sdk/index.ts"
    },
    "./env": {
      "react-server": "./src/env.react-server.ts",
      "browser": "./src/env.browser.ts",
      "bun": "./src/env.ts",
      "import": "./src/env.ts",
      "types": "./src/env.ts",
      "default": "./src/env.ts"
    },
    "./*": {
      "bun": "./src/*.ts",
      "import": "./src/*.ts",
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "bun test"
  },
  "sideEffects": false,
  "engines": {
    "bun": "1.3.11"
  },
  "dependencies": {
    "@ai-sdk/provider": "^2.0.1",
    "@ai-sdk/provider-utils": "^3.0.17",
    "@codebuff/common": "workspace:*",
    "ai": "^5.0.52"
  },
  "devDependencies": {
    "msw": "^2.12.1"
  }
}
